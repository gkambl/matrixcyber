import React, { useEffect, useRef, useCallback, useState } from 'react';
import { GameState, GameMode, Player, Enemy, Tower, Projectile } from '../types/game';
import { getRandomQuestion } from '../data/securityQuestions';
import SecurityQuizModal from './SecurityQuizModal';
import SecurityTipModal from './SecurityTipModal';
import LevelProgressTracker from './LevelProgressTracker';
import { getCurrentLevel } from '../data/gameLevels';

interface TowerDefenseGameProps {
  gameState: GameState;
  gameMode: GameMode;
  currentLevel: number;
  onGameStateChange: (state: GameState) => void;
  onScoreUpdate: (score: number) => void;
  onLivesUpdate: (lives: number) => void;
  onWaveUpdate: (wave: number) => void;
  onQuizCorrect: () => void;
  correctAnswersInLevel: number;
}

const TowerDefenseGame: React.FC<TowerDefenseGameProps> = ({
  gameState,
  gameMode,
  currentLevel,
  onGameStateChange,
  onScoreUpdate,
  onLivesUpdate,
  onWaveUpdate,
  onQuizCorrect,
  correctAnswersInLevel
}) => {
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const gameLoopRef = useRef<number>();
  const [selectedTowerType, setSelectedTowerType] = useState<Tower['type']>('archer');
  const [towers, setTowers] = useState<Tower[]>([]);
  const [enemies, setEnemies] = useState<Enemy[]>([]);
  const [projectiles, setProjectiles] = useState<Projectile[]>([]);
  const [player, setPlayer] = useState<Player>({
    x: 100,
    y: 300,
    health: 100,
    maxHealth: 100,
    mana: 50,
    maxMana: 50,
    experience: 0,
    level: 1,
    abilities: []
  });
  const [showQuiz, setShowQuiz] = useState(false);
  const [currentQuiz, setCurrentQuiz] = useState<any>(null);
  const [showSecurityTip, setShowSecurityTip] = useState(false);
  const [currentSecurityTip, setCurrentSecurityTip] = useState<any>(null);
  const [hasShownFirewallTip, setHasShownFirewallTip] = useState(false);
  const [hasShownLayeredDefenseTip, setHasShownLayeredDefenseTip] = useState(false);
  const [hasShownChokepointTip, setHasShownChokepointTip] = useState(false);
  const [gold, setGold] = useState(1000);
  const [score, setScore] = useState(0);
  const [lives, setLives] = useState(25);
  const [wave, setWave] = useState(1);
  const [triggeredQuizzes, setTriggeredQuizzes] = useState<Set<string>>(new Set());

  // Current level wave tracking
  const [currentWaveIndex, setCurrentWaveIndex] = useState(0);
  const [waveEnemiesSpawned, setWaveEnemiesSpawned] = useState(0);
  const [waveTimer, setWaveTimer] = useState(0);
  const [lastSpawnTime, setLastSpawnTime] = useState(0);

  // Level-specific background drawing function
  const drawLevelBackground = (ctx: CanvasRenderingContext2D, canvas: HTMLCanvasElement, level: number) => {
    switch (level) {
      case 1: // The Matrix Awakening - Green digital world
        {
          const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
          gradient.addColorStop(0, '#000000');
          gradient.addColorStop(0.5, '#001100');
          gradient.addColorStop(1, '#000000');
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          
          // Matrix digital rain
          ctx.strokeStyle = 'rgba(0, 255, 65, 0.1)';
          ctx.lineWidth = 1;
          ctx.font = '12px monospace';
          ctx.fillStyle = 'rgba(0, 255, 65, 0.1)';
          for (let x = 0; x < canvas.width; x += 20) {
            for (let y = 0; y < canvas.height; y += 20) {
              if (Math.random() < 0.1) {
                ctx.fillText(Math.random() > 0.5 ? '1' : '0', x, y);
              }
            }
          }
          
          // Digital grid
          ctx.strokeStyle = 'rgba(0, 255, 65, 0.05)';
          for (let x = 0; x < canvas.width; x += 50) {
            ctx.beginPath();
            ctx.moveTo(x, 0);
            ctx.lineTo(x, canvas.height);
            ctx.stroke();
          }
        }
        break;
        
      case 2: // Zion's Digital Defense - Blue tech fortress
        {
          const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
          gradient.addColorStop(0, '#000033');
          gradient.addColorStop(0.5, '#001155');
          gradient.addColorStop(1, '#000033');
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          
          // Tech circuit patterns
          ctx.strokeStyle = 'rgba(0, 150, 255, 0.1)';
          ctx.lineWidth = 2;
          for (let x = 0; x < canvas.width; x += 100) {
            for (let y = 0; y < canvas.height; y += 100) {
              ctx.strokeRect(x, y, 80, 80);
              ctx.beginPath();
              ctx.arc(x + 40, y + 40, 20, 0, Math.PI * 2);
              ctx.stroke();
            }
          }
          
          // Zion energy streams
          ctx.strokeStyle = 'rgba(0, 200, 255, 0.2)';
          ctx.lineWidth = 3;
          for (let i = 0; i < 5; i++) {
            ctx.beginPath();
            ctx.moveTo(0, i * 120 + 60);
            ctx.lineTo(canvas.width, i * 120 + 60);
            ctx.stroke();
          }
        }
        break;
        
      case 3: // The Nebuchadnezzar Protocol - Ship interior
        {
          const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
          gradient.addColorStop(0, '#330000');
          gradient.addColorStop(0.5, '#550011');
          gradient.addColorStop(1, '#330000');
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          
          // Ship hull patterns
          ctx.fillStyle = 'rgba(100, 50, 50, 0.3)';
          for (let y = 0; y < canvas.height; y += 40) {
            ctx.fillRect(0, y, canvas.width, 20);
          }
          
          // Ship corridors
          ctx.strokeStyle = 'rgba(255, 100, 100, 0.2)';
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.moveTo(0, canvas.height * 0.3);
          ctx.lineTo(canvas.width, canvas.height * 0.3);
          ctx.moveTo(0, canvas.height * 0.7);
          ctx.lineTo(canvas.width, canvas.height * 0.7);
          ctx.stroke();
          
          // Emergency lighting
          ctx.fillStyle = 'rgba(255, 0, 0, 0.1)';
          for (let x = 50; x < canvas.width; x += 100) {
            ctx.beginPath();
            ctx.arc(x, 30, 15, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        break;
        
      case 4: // Machine City Firewall - Dark mechanical
        {
          const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
          gradient.addColorStop(0, '#1a0a00');
          gradient.addColorStop(0.5, '#2a1500');
          gradient.addColorStop(1, '#1a0a00');
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          
          // Machine city structures
          ctx.fillStyle = 'rgba(100, 50, 0, 0.2)';
          for (let x = 0; x < canvas.width; x += 60) {
            const height = Math.random() * 200 + 100;
            ctx.fillRect(x, canvas.height - height, 40, height);
          }
          
          // Industrial pipes
          ctx.strokeStyle = 'rgba(150, 75, 0, 0.3)';
          ctx.lineWidth = 8;
          for (let i = 0; i < 4; i++) {
            ctx.beginPath();
            ctx.moveTo(0, i * 150 + 75);
            ctx.lineTo(canvas.width, i * 150 + 100);
            ctx.stroke();
          }
          
          // Machine sparks
          ctx.fillStyle = 'rgba(255, 150, 0, 0.4)';
          for (let i = 0; i < 20; i++) {
            if (Math.random() < 0.3) {
              ctx.beginPath();
              ctx.arc(Math.random() * canvas.width, Math.random() * canvas.height, 2, 0, Math.PI * 2);
              ctx.fill();
            }
          }
        }
        break;
        
      case 5: // Smith Virus Containment - Corrupted reality
        {
          const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
          gradient.addColorStop(0, '#000000');
          gradient.addColorStop(0.3, '#001100');
          gradient.addColorStop(0.7, '#110000');
          gradient.addColorStop(1, '#000000');
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          
          // Corrupted Matrix code
          ctx.font = '14px monospace';
          ctx.fillStyle = 'rgba(255, 0, 0, 0.2)';
          for (let x = 0; x < canvas.width; x += 25) {
            for (let y = 0; y < canvas.height; y += 25) {
              if (Math.random() < 0.15) {
                ctx.fillText('S', x, y);
              }
            }
          }
          
          // Virus spread pattern
          ctx.strokeStyle = 'rgba(255, 0, 0, 0.1)';
          ctx.lineWidth = 2;
          const centerX = canvas.width / 2;
          const centerY = canvas.height / 2;
          for (let i = 0; i < 8; i++) {
            const angle = (i * Math.PI) / 4;
            ctx.beginPath();
            ctx.moveTo(centerX, centerY);
            ctx.lineTo(
              centerX + Math.cos(angle) * 300,
              centerY + Math.sin(angle) * 200
            );
            ctx.stroke();
          }
          
          // Glitch effects
          if (Math.random() < 0.1) {
            ctx.fillStyle = 'rgba(255, 255, 255, 0.1)';
            ctx.fillRect(Math.random() * canvas.width, Math.random() * canvas.height, 50, 5);
          }
        }
        break;
        
      default:
        // Fallback to level 1 style
        {
          const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
          gradient.addColorStop(0, '#000000');
          gradient.addColorStop(0.5, '#001100');
          gradient.addColorStop(1, '#000000');
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, canvas.width, canvas.height);
        }
    }
  };

  // Level-specific base/fortress drawing function
  const drawLevelBase = (ctx: CanvasRenderingContext2D, canvas: HTMLCanvasElement, level: number, enemyCount: number) => {
    switch (level) {
      case 1: // Matrix Mainframe
        {
          ctx.fillStyle = '#00ff41';
          ctx.shadowColor = '#00ff41';
          ctx.shadowBlur = 10;
          ctx.fillRect(0, 0, 120, canvas.height);
          ctx.shadowBlur = 0;
          
          // Matrix interface screens
          ctx.fillStyle = '#000000';
          ctx.fillRect(15, 60, 15, 20);
          ctx.fillRect(90, 60, 15, 20);
          
          ctx.fillStyle = '#00ff41';
          ctx.font = '8px monospace';
          ctx.fillText('NEO', 17, 72);
          ctx.fillText('ZIO', 92, 72);
          
          // Central console
          ctx.fillStyle = '#001100';
          ctx.fillRect(35, 80, 50, 70);
          ctx.strokeStyle = '#00ff41';
          ctx.lineWidth = 2;
          ctx.strokeRect(35, 80, 50, 70);
          
          ctx.fillStyle = '#00ff41';
          ctx.font = '10px monospace';
          ctx.fillText('MATRIX', 40, 95);
          ctx.fillText('ACTIVE', 45, 110);
          ctx.fillText('AGENTS:', 40, 125);
          ctx.fillText(`${enemyCount}`, 55, 140);
        }
        break;
        
      case 2: // Zion Command Center
        {
          ctx.fillStyle = '#0080ff';
          ctx.shadowColor = '#0080ff';
          ctx.shadowBlur = 12;
          ctx.fillRect(0, 0, 120, canvas.height);
          ctx.shadowBlur = 0;
          
          // Zion architecture
          ctx.fillStyle = '#004080';
          for (let i = 0; i < 8; i++) {
            ctx.fillRect(10, 50 + i * 60, 100, 30);
          }
          
          // Command screens
          ctx.fillStyle = '#000040';
          ctx.fillRect(20, 100, 80, 60);
          ctx.strokeStyle = '#0080ff';
          ctx.lineWidth = 2;
          ctx.strokeRect(20, 100, 80, 60);
          
          ctx.fillStyle = '#0080ff';
          ctx.font = '10px monospace';
          ctx.fillText('ZION DEFENSE', 25, 115);
          ctx.fillText('STATUS: ACTIVE', 25, 130);
          ctx.fillText('THREATS:', 25, 145);
          ctx.fillText(`${enemyCount}`, 75, 145);
        }
        break;
        
      case 3: // Nebuchadnezzar Bridge
        {
          ctx.fillStyle = '#ff4040';
          ctx.shadowColor = '#ff4040';
          ctx.shadowBlur = 8;
          ctx.fillRect(0, 0, 120, canvas.height);
          ctx.shadowBlur = 0;
          
          // Ship hull plating
          ctx.fillStyle = '#802020';
          for (let i = 0; i < 10; i++) {
            ctx.fillRect(5, i * 60, 110, 40);
          }
          
          // Ship controls
          ctx.fillStyle = '#400000';
          ctx.fillRect(25, 200, 70, 80);
          ctx.strokeStyle = '#ff4040';
          ctx.lineWidth = 2;
          ctx.strokeRect(25, 200, 70, 80);
          
          ctx.fillStyle = '#ff4040';
          ctx.font = '9px monospace';
          ctx.fillText('NEBUCHADNEZZAR', 27, 215);
          ctx.fillText('SHIP DEFENSE', 35, 230);
          ctx.fillText('HOSTILES:', 35, 250);
          ctx.fillText(`${enemyCount}`, 75, 250);
        }
        break;
        
      case 4: // Machine City Core
        {
          ctx.fillStyle = '#ff8800';
          ctx.shadowColor = '#ff8800';
          ctx.shadowBlur = 15;
          ctx.fillRect(0, 0, 120, canvas.height);
          ctx.shadowBlur = 0;
          
          // Machine architecture
          ctx.fillStyle = '#804400';
          for (let i = 0; i < 6; i++) {
            const height = 80 + i * 20;
            ctx.fillRect(10, 50 + i * 80, 100, height);
          }
          
          // Machine core
          ctx.fillStyle = '#ff4400';
          ctx.beginPath();
          ctx.arc(60, 300, 40, 0, Math.PI * 2);
          ctx.fill();
          
          ctx.fillStyle = '#000000';
          ctx.font = '8px monospace';
          ctx.fillText('MACHINE CORE', 25, 250);
          ctx.fillText('FIREWALL ACTIVE', 20, 265);
          ctx.fillText('INTRUSIONS:', 25, 330);
          ctx.fillText(`${enemyCount}`, 75, 330);
        }
        break;
        
      case 5: // Smith Virus Core
        {
          // Corrupted base - mix of green and red
          const gradient = ctx.createLinearGradient(0, 0, 120, 0);
          gradient.addColorStop(0, '#00ff41');
          gradient.addColorStop(0.5, '#ff0000');
          gradient.addColorStop(1, '#00ff41');
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, 120, canvas.height);
          
          // Corrupted patterns
          ctx.fillStyle = '#800000';
          for (let i = 0; i < 12; i++) {
            if (Math.random() < 0.7) {
              ctx.fillRect(Math.random() * 120, i * 50, 20, 30);
            }
          }
          
          // Virus core
          ctx.fillStyle = '#000000';
          ctx.fillRect(30, 250, 60, 100);
          ctx.strokeStyle = '#ff0000';
          ctx.lineWidth = 3;
          ctx.strokeRect(30, 250, 60, 100);
          
          ctx.fillStyle = '#ff0000';
          ctx.font = '9px monospace';
          ctx.fillText('SMITH VIRUS', 35, 270);
          ctx.fillText('CONTAINMENT', 35, 285);
          ctx.fillText('REPLICAS:', 40, 320);
          ctx.fillText(`${enemyCount}`, 75, 320);
          
          // Glitch effect on text
          if (Math.random() < 0.2) {
            ctx.fillStyle = '#ffffff';
            ctx.fillText('SMITH VIRUS', 36, 271);
          }
        }
        break;
    }
  };

  const drawLevel = (ctx: CanvasRenderingContext2D) => {
    const level = getCurrentLevel(currentLevel);
    if (!level) return;

    // Clear background
    ctx.fillStyle = '#000000';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Draw level-specific designs
    switch (currentLevel) {
      case 1: // The Matrix Awakening - Digital code streams
        drawMatrixAwakeningLevel(ctx);
        break;
      case 2: // Zion's Digital Defense - Underground bunker
        drawZionDefenseLevel(ctx);
        break;
      case 3: // Nebuchadnezzar Protocol - Ship interior
        drawNebuchadnezzarLevel(ctx);
        break;
      case 4: // Machine City Firewall - Industrial machine city
        drawMachineCityLevel(ctx);
        break;
      case 5: // Smith Virus Containment - Corrupted reality
        drawSmithVirusLevel(ctx);
        break;
      default:
        drawMatrixAwakeningLevel(ctx);
    }
  };

  const drawMatrixAwakeningLevel = (ctx: CanvasRenderingContext2D) => {
    // Digital Matrix environment with falling code
    ctx.fillStyle = '#001100';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Animated digital rain columns
    ctx.fillStyle = '#00ff41';
    ctx.globalAlpha = 0.3;
    for (let x = 0; x < canvas.width; x += 20) {
      const offset = (Date.now() / 100 + x) % canvas.height;
      for (let y = -50; y < canvas.height + 50; y += 30) {
        const charY = (y + offset) % (canvas.height + 100);
        if (charY > 0 && charY < canvas.height) {
          ctx.font = '12px monospace';
          ctx.fillText(Math.random() > 0.5 ? '1' : '0', x, charY);
        }
      }
    }
    ctx.globalAlpha = 1;

    // Neo's awakening pod area (left side)
    ctx.fillStyle = '#002200';
    ctx.fillRect(0, 0, 180, canvas.height);
    
    // Pod interface panels
    ctx.fillStyle = '#00ff41';
    ctx.fillRect(20, 50, 140, 100);
    ctx.fillStyle = '#001100';
    ctx.fillRect(25, 55, 130, 90);
    
    // Digital readouts
    ctx.fillStyle = '#00ff41';
    ctx.font = '10px monospace';
    ctx.fillText('NEURAL LINK: ACTIVE', 30, 75);
    ctx.fillText('REALITY: SIMULATED', 30, 90);
    ctx.fillText('THREAT LEVEL: LOW', 30, 105);
    ctx.fillText('DEFENSE: INITIALIZING', 30, 120);

    // Data streams flowing right
    ctx.strokeStyle = '#00ff41';
    ctx.lineWidth = 2;
    ctx.globalAlpha = 0.6;
    for (let i = 0; i < 5; i++) {
      const y = 200 + i * 80;
      const flow = (Date.now() / 50) % 200;
      ctx.beginPath();
      ctx.moveTo(180, y);
      ctx.lineTo(180 + flow, y);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;

    // Border
    ctx.strokeStyle = '#00ff41';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(180, 0);
    ctx.lineTo(180, canvas.height);
    ctx.stroke();
  };

  const drawZionDefenseLevel = (ctx: CanvasRenderingContext2D) => {
    // Underground bunker with tech panels
    ctx.fillStyle = '#000033';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Rock/concrete texture background
    ctx.fillStyle = '#111122';
    for (let x = 0; x < canvas.width; x += 60) {
      for (let y = 0; y < canvas.height; y += 60) {
        if (Math.random() > 0.7) {
          ctx.fillRect(x + Math.random() * 20, y + Math.random() * 20, 40, 40);
        }
      }
    }

    // Zion command center (left side)
    ctx.fillStyle = '#001133';
    ctx.fillRect(0, 0, 180, canvas.height);
    
    // Command center screens
    for (let i = 0; i < 4; i++) {
      const y = 50 + i * 120;
      // Screen frame
      ctx.fillStyle = '#4488ff';
      ctx.fillRect(15, y, 150, 80);
      // Screen content
      ctx.fillStyle = '#000066';
      ctx.fillRect(20, y + 5, 140, 70);
      
      // Screen data
      ctx.fillStyle = '#4488ff';
      ctx.font = '8px monospace';
      ctx.fillText('ZION DEFENSE GRID', 25, y + 20);
      ctx.fillText('SECTOR STATUS: ACTIVE', 25, y + 35);
      ctx.fillText('SENTINELS: DEPLOYED', 25, y + 50);
      ctx.fillText(`THREAT LEVEL: ${i + 1}`, 25, y + 65);
    }

    // Power conduits
    ctx.strokeStyle = '#4488ff';
    ctx.lineWidth = 4;
    ctx.globalAlpha = 0.8;
    for (let i = 0; i < 3; i++) {
      const x = 180 + i * 200;
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, canvas.height);
      ctx.stroke();
      
      // Energy pulses
      const pulse = (Date.now() / 100 + i * 50) % canvas.height;
      ctx.fillStyle = '#88ccff';
      ctx.fillRect(x - 2, pulse, 4, 20);
    }
    ctx.globalAlpha = 1;

    // Border
    ctx.strokeStyle = '#4488ff';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(180, 0);
    ctx.lineTo(180, canvas.height);
    ctx.stroke();
  };

  const drawNebuchadnezzarLevel = (ctx: CanvasRenderingContext2D) => {
    // Ship interior with metal plating
    ctx.fillStyle = '#220000';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Metal hull plating pattern
    ctx.strokeStyle = '#440000';
    ctx.lineWidth = 2;
    for (let x = 0; x < canvas.width; x += 80) {
      for (let y = 0; y < canvas.height; y += 80) {
        ctx.strokeRect(x, y, 80, 80);
        // Rivets
        ctx.fillStyle = '#660000';
        ctx.fillRect(x + 5, y + 5, 4, 4);
        ctx.fillRect(x + 71, y + 5, 4, 4);
        ctx.fillRect(x + 5, y + 71, 4, 4);
        ctx.fillRect(x + 71, y + 71, 4, 4);
      }
    }

    // Ship control room (left side)
    ctx.fillStyle = '#330000';
    ctx.fillRect(0, 0, 180, canvas.height);
    
    // Ship control panels
    ctx.fillStyle = '#ff4444';
    ctx.fillRect(10, 40, 160, 120);
    ctx.fillStyle = '#110000';
    ctx.fillRect(15, 45, 150, 110);
    
    // Control interfaces
    ctx.fillStyle = '#ff4444';
    ctx.font = '10px monospace';
    ctx.fillText('NEBUCHADNEZZAR', 20, 65);
    ctx.fillText('HULL INTEGRITY: 87%', 20, 80);
    ctx.fillText('ENGINES: ONLINE', 20, 95);
    ctx.fillText('WEAPONS: ARMED', 20, 110);
    ctx.fillText('CREW STATUS: ALERT', 20, 125);
    ctx.fillText('EMP: READY', 20, 140);

    // Ship corridors/passages
    ctx.fillStyle = '#440000';
    for (let i = 0; i < 3; i++) {
      const y = 200 + i * 100;
      ctx.fillRect(180, y, canvas.width - 180, 30);
      // Corridor lighting
      ctx.fillStyle = '#ff6666';
      for (let x = 200; x < canvas.width; x += 100) {
        ctx.fillRect(x, y + 10, 60, 10);
      }
      ctx.fillStyle = '#440000';
    }

    // Emergency lighting strips
    ctx.fillStyle = '#ff0000';
    ctx.globalAlpha = 0.6 + 0.4 * Math.sin(Date.now() / 200);
    ctx.fillRect(180, 0, 5, canvas.height);
    ctx.fillRect(180, canvas.height - 5, canvas.width - 180, 5);
    ctx.globalAlpha = 1;

    // Border
    ctx.strokeStyle = '#ff4444';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(180, 0);
    ctx.lineTo(180, canvas.height);
    ctx.stroke();
  };

  const drawMachineCityLevel = (ctx: CanvasRenderingContext2D) => {
    // Industrial machine city
    ctx.fillStyle = '#221100';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Industrial pipes and machinery
    ctx.strokeStyle = '#664400';
    ctx.lineWidth = 8;
    for (let i = 0; i < 6; i++) {
      const y = 50 + i * 80;
      ctx.beginPath();
      ctx.moveTo(200, y);
      ctx.lineTo(canvas.width, y);
      ctx.stroke();
      
      // Pipe joints
      ctx.fillStyle = '#885500';
      for (let x = 250; x < canvas.width; x += 150) {
        ctx.fillRect(x - 10, y - 15, 20, 30);
      }
    }

    // Machine towers in background
    ctx.fillStyle = '#443300';
    for (let i = 0; i < 8; i++) {
      const x = 300 + i * 80;
      const height = 200 + Math.random() * 200;
      ctx.fillRect(x, canvas.height - height, 40, height);
      
      // Tower lights
      ctx.fillStyle = '#ffaa00';
      for (let j = 0; j < 5; j++) {
        const lightY = canvas.height - height + j * 40;
        if (Math.random() > 0.5) {
          ctx.fillRect(x + 15, lightY, 10, 5);
        }
      }
      ctx.fillStyle = '#443300';
    }

    // Machine control center (left side)
    ctx.fillStyle = '#332200';
