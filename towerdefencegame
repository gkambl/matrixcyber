    // Campaign mode: spawn based on current wave configuration OR keep spawning if quiz requirements not met
    const currentTime = Date.now();
    
    // Check if we need to keep spawning enemies for quiz requirements
    const needsMoreQuizzes = correctAnswersInLevel < 5;
    const totalEnemiesInWave = currentWave.enemies.reduce((sum, group) => sum + group.count, 0);
    
    // If we've spawned all enemies for this wave but still need quizzes, keep spawning
    if (waveEnemiesSpawned >= totalEnemiesInWave && needsMoreQuizzes) {
      // Continue spawning enemies from the last enemy group until quiz requirements are met
      if (currentTime - lastSpawnTime >= 2000) { // Spawn every 2 seconds
        const lastEnemyGroup = currentWave.enemies[currentWave.enemies.length - 1];
        spawnEnemy(lastEnemyGroup.type);
        setLastSpawnTime(currentTime);
      }
      return;
    } else if (waveEnemiesSpawned >= totalEnemiesInWave && !needsMoreQuizzes) {
      // Wave is complete and quiz requirements are met
      return;
    }
    
    // Find which enemy group should be spawning now
    let spawnedSoFar = 0;
    
    for (const enemyGroup of currentWave.enemies) {
      const groupStartIndex = spawnedSoFar;
      const groupEndIndex = spawnedSoFar + enemyGroup.count;
      
      // If we're in the range for this group and haven't spawned all of them
      if (waveEnemiesSpawned >= groupStartIndex && waveEnemiesSpawned < groupEndIndex) {
        if (currentTime - lastSpawnTime >= enemyGroup.spawnDelay) {
          spawnEnemy(enemyGroup.type);
          setWaveEnemiesSpawned(prev => prev + 1);
          setLastSpawnTime(currentTime);
          return;
        }
        return; // Still waiting for spawn delay
