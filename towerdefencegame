        ctx.fillRect(tower.x - 8, tower.y - 18, 16, 10);
        
        // Morpheus glasses
        ctx.fillStyle = '#000080';
        ctx.fillRect(tower.x - 7, tower.y - 16, 14, 4);
        
        // Wisdom aura
        ctx.strokeStyle = '#0080ff';
        ctx.lineWidth = 2;
        ctx.setLineDash([3, 3]);
        ctx.beginPath();
        ctx.arc(tower.x, tower.y, 18, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);
      } else if (tower.type === 'ballista') {
        // Trinity - The Operator
        ctx.fillStyle = '#ffaa00';
        ctx.shadowColor = '#ffaa00';
        ctx.shadowBlur = 10;
        
        // Trinity body (leather outfit)
        ctx.fillRect(tower.x - 8, tower.y - 15, 16, 30);
        ctx.shadowBlur = 0;
        
        // Trinity head
        ctx.fillStyle = '#804400';
        ctx.fillRect(tower.x - 6, tower.y - 18, 12, 8);
        
        // Hair
        ctx.fillStyle = '#000000';
        ctx.fillRect(tower.x - 7, tower.y - 20, 14, 6);
        
        // Sniper targeting
        ctx.strokeStyle = '#ffaa00';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(tower.x, tower.y, 20, 0, Math.PI * 2);
        ctx.moveTo(tower.x - 15, tower.y);
        ctx.lineTo(tower.x + 15, tower.y);
        ctx.moveTo(tower.x, tower.y - 15);
        ctx.lineTo(tower.x, tower.y + 15);
        ctx.stroke();
      } else if (tower.type === 'firewall') {
        // Sentinel Defense System
        ctx.fillStyle = '#ff0040';
        ctx.shadowColor = '#ff0040';
        ctx.shadowBlur = 15;
        
        // Sentinel body (mechanical)
        ctx.fillRect(tower.x - 10, tower.y - 10, 20, 20);
        ctx.shadowBlur = 0;
        
        // Sentinel tentacles
        ctx.strokeStyle = '#ff0040';
        ctx.lineWidth = 3;
        for (let i = 0; i < 6; i++) {
          const angle = (i * Math.PI) / 3;
          const length = 12 + Math.sin(Date.now() * 0.01 + i) * 3;
          ctx.beginPath();
          ctx.moveTo(tower.x, tower.y);
          ctx.lineTo(
            tower.x + Math.cos(angle) * length,
            tower.y + Math.sin(angle) * length
          );
          ctx.stroke();
        }
        
        // Sentinel eye
        ctx.fillStyle = '#ff4080';
        ctx.beginPath();
        ctx.arc(tower.x, tower.y, 4, 0, Math.PI * 2);
        ctx.fill();
        
        // Defense field
        ctx.strokeStyle = '#ff0040';
        ctx.lineWidth = 1;
        ctx.setLineDash([2, 2]);
        ctx.beginPath();
        ctx.arc(tower.x, tower.y, 20, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);
      }
      
      // Draw range circle when selected
      if (selectedTowerType === tower.type) {
        ctx.strokeStyle = config.color + '60';
        ctx.lineWidth = 2;
        ctx.setLineDash([5, 5]);
        ctx.beginPath();
        ctx.arc(tower.x, tower.y, tower.range, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);
      }
    });
    ctx.beginPath();
    ctx.moveTo(0, canvas.height * 0.5);
    ctx.lineTo(200, canvas.height * 0.3);
    ctx.lineTo(400, canvas.height * 0.4);
    ctx.lineTo(600, canvas.height * 0.2);
    ctx.lineTo(800, canvas.height * 0.35);
    ctx.lineTo(800, canvas.height * 0.7);
    ctx.lineTo(0, canvas.height * 0.7);
    ctx.closePath();
    ctx.fill();

    // Draw Gondor fortress with better design
    ctx.fillStyle = '#6b7280';
    ctx.fillRect(0, 0, 120, canvas.height);
    
    // Add fortress wall texture
    ctx.fillStyle = '#4b5563';
    for (let i = 0; i < 8; i++) {
      ctx.fillRect(10, 50 + i * 70, 100, 10);
    }
    
    // Add fortress towers
    ctx.fillStyle = '#6b7280';
    ctx.fillRect(10, 50, 25, 150);
    ctx.fillRect(85, 50, 25, 150);
    
    // Tower tops
    ctx.fillStyle = '#4b5563';
    ctx.fillRect(5, 40, 35, 20);
    ctx.fillRect(80, 40, 35, 20);
    
    // Gondor banner - simplified and cleaner
    ctx.fillStyle = '#f1f5f9';
    ctx.fillRect(35, 80, 50, 70);
    
    // White Tree of Gondor (simplified)
    ctx.fillStyle = '#1e40af';
    ctx.fillRect(45, 90, 30, 50);
    
    // Tree trunk
    ctx.fillStyle = '#8b4513';
    ctx.fillRect(58, 120, 4, 15);
    
    // Tree branches
    ctx.strokeStyle = '#8b4513';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(60, 120);
    ctx.lineTo(55, 110);
    ctx.moveTo(60, 120);
    ctx.lineTo(65, 110);
    ctx.moveTo(60, 115);
    ctx.lineTo(52, 105);
    ctx.moveTo(60, 115);
    ctx.lineTo(68, 105);
    ctx.stroke();

    // Draw paths
    gamePaths.forEach(path => {
      ctx.strokeStyle = '#8b7355';
      ctx.lineWidth = 25;
      ctx.beginPath();
      ctx.moveTo(path[0].x, path[0].y);
      path.forEach(point => ctx.lineTo(point.x, point.y));
      ctx.stroke();
      
      // Add path borders
      ctx.strokeStyle = '#654321';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(path[0].x, path[0].y - 12);
      path.forEach(point => ctx.lineTo(point.x, point.y - 12));
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(path[0].x, path[0].y + 12);
      path.forEach(point => ctx.lineTo(point.x, point.y + 12));
      ctx.stroke();
    });

    // Draw towers with LOTR styling
    towers.forEach(tower => {
      const config = towerTypes[tower.type];
      
      // Reset any shadow effects
      ctx.shadowBlur = 0;
      ctx.shadowColor = 'transparent';
      
      if (tower.type === 'archer') {
        // Draw archer tower as a stone watchtower
        ctx.fillStyle = '#6b7280';
        ctx.fillRect(tower.x - 12, tower.y - 12, 24, 24);
        ctx.fillStyle = '#4b5563';
        ctx.fillRect(tower.x - 10, tower.y - 10, 20, 20);
        // Add crenellations
        ctx.fillStyle = '#6b7280';
        for (let i = 0; i < 3; i++) {
          ctx.fillRect(tower.x - 12 + i * 8, tower.y - 16, 4, 4);
        }
        // Add archer figure
        ctx.fillStyle = '#22c55e';
        ctx.fillRect(tower.x - 3, tower.y - 6, 6, 8);
        // Bow
        ctx.strokeStyle = '#8b4513';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(tower.x + 8, tower.y, 6, 0, Math.PI);
        ctx.stroke();
      } else if (tower.type === 'mage') {
        // Draw mage tower as a crystal spire
        ctx.fillStyle = '#1e1b4b';
        ctx.fillRect(tower.x - 10, tower.y - 10, 20, 20);
        // Crystal on top
        ctx.fillStyle = '#3b82f6';
        ctx.beginPath();
        ctx.moveTo(tower.x, tower.y - 15);
        ctx.lineTo(tower.x - 6, tower.y - 5);
        ctx.lineTo(tower.x + 6, tower.y - 5);
        ctx.closePath();
        ctx.fill();
        // Magical glow
        ctx.shadowColor = '#3b82f6';
      } else if (tower.type === 'ballista') {
        // Draw ballista as a siege weapon
        ctx.fillStyle = '#8b4513';
        ctx.fillRect(tower.x - 15, tower.y - 8, 30, 16);
        // Ballista arms
        ctx.strokeStyle = '#654321';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(tower.x - 10, tower.y - 8);
        ctx.lineTo(tower.x - 15, tower.y - 15);
        ctx.moveTo(tower.x + 10, tower.y - 8);
        ctx.lineTo(tower.x + 15, tower.y - 15);
        ctx.stroke();
      } else if (tower.type === 'firewall') {
        // Draw firewall as a magical barrier
        ctx.fillStyle = '#dc2626';
        ctx.fillRect(tower.x - 8, tower.y - 12, 16, 24);
        // Flame effects
        for (let i = 0; i < 5; i++) {
          ctx.fillStyle = i % 2 === 0 ? '#f59e0b' : '#ef4444';
          ctx.beginPath();
          ctx.arc(tower.x - 6 + i * 3, tower.y - 15 + Math.sin(Date.now() * 0.01 + i) * 3, 2, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      
      // Draw range circle when selected
      if (selectedTowerType === tower.type) {
        ctx.strokeStyle = config.color + '60';
        ctx.lineWidth = 2;
        ctx.setLineDash([5, 5]);
        ctx.beginPath();
        ctx.arc(tower.x, tower.y, tower.range, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);
      }
    });

    // Draw enemies with LOTR orc styling
    enemies.forEach(enemy => {
      // Reset any effects
      ctx.shadowBlur = 0;
      ctx.shadowColor = 'transparent';
      
      const config = enemyTypes[enemy.type];
      
      if (enemy.type === 'grunt') {
        // Basic Malware
        ctx.fillStyle = '#ff0040';
        ctx.shadowColor = '#ff0040';
        ctx.shadowBlur = 5;
        ctx.fillRect(enemy.x - 8, enemy.y - 8, 16, 16);
        ctx.shadowBlur = 0;
        
        // Digital core
        ctx.fillStyle = '#800020';
        ctx.fillRect(enemy.x - 4, enemy.y - 4, 8, 8);
        
        // Threat indicators
        ctx.fillStyle = '#ff0040';
        ctx.fillRect(enemy.x - 2, enemy.y - 6, 1, 2);
        ctx.fillRect(enemy.x + 1, enemy.y - 6, 1, 2);
      } else if (enemy.type === 'warrior') {
        // Advanced Trojan
        ctx.fillStyle = '#ff4000';
        ctx.shadowColor = '#ff4000';
        ctx.shadowBlur = 8;
        ctx.fillRect(enemy.x - 10, enemy.y - 10, 20, 20);
        ctx.shadowBlur = 0;
        
        // Encrypted shell
        ctx.fillStyle = '#802000';
        ctx.fillRect(enemy.x - 8, enemy.y - 8, 16, 4);
        ctx.fillRect(enemy.x - 8, enemy.y, 16, 4);
        
        // Attack vector
        ctx.fillStyle = '#ff4000';
        ctx.fillRect(enemy.x + 8, enemy.y - 6, 4, 12);
      } else if (enemy.type === 'berserker') {
        // Ransomware
        ctx.fillStyle = '#ff8000';
        ctx.shadowColor = '#ff8000';
        ctx.shadowBlur = 10;
        ctx.fillRect(enemy.x - 9, enemy.y - 9, 18, 18);
        ctx.shadowBlur = 0;
        
        // Encryption spikes
        for (let i = 0; i < 6; i++) {
          ctx.fillStyle = '#804000';
          ctx.fillRect(enemy.x - 8 + i * 3, enemy.y - 12, 2, 4);
        }
        
        // Payload extensions
        ctx.fillStyle = '#ffaa00';
        ctx.fillRect(enemy.x - 12, enemy.y - 2, 4, 2);
        ctx.fillRect(enemy.x + 8, enemy.y - 2, 4, 2);
      } else if (enemy.type === 'uruk') {
        // Advanced Persistent Threat
        ctx.fillStyle = '#8000ff';
        ctx.shadowColor = '#8000ff';
        ctx.shadowBlur = 12;
        ctx.fillRect(enemy.x - 14, enemy.y - 14, 28, 28);
        ctx.shadowBlur = 0;
        
        // Stealth layers
        ctx.fillStyle = '#400080';
        ctx.fillRect(enemy.x - 12, enemy.y - 12, 24, 8);
        ctx.fillRect(enemy.x - 12, enemy.y, 24, 8);
        
        // Command & Control
        ctx.fillStyle = '#8000ff';
        ctx.fillRect(enemy.x + 12, enemy.y - 8, 6, 16);
      } else if (enemy.type === 'troll') {
        // Botnet Controller
        ctx.fillStyle = '#404040';
        ctx.shadowColor = '#808080';
        ctx.shadowBlur = 15;
        ctx.fillRect(enemy.x - 18, enemy.y - 18, 36, 36);
        ctx.shadowBlur = 0;
        
        // Network nodes
        ctx.fillStyle = '#606060';
        for (let i = 0; i < 4; i++) {
          ctx.fillRect(enemy.x - 15 + i * 8, enemy.y - 15, 6, 6);
          ctx.fillRect(enemy.x - 15 + i * 8, enemy.y - 5, 6, 6);
        }
        
        // Control signals
        ctx.fillStyle = '#ff0000';
        ctx.shadowColor = '#ff0000';
        ctx.shadowBlur = 5;
        ctx.fillRect(enemy.x - 8, enemy.y - 12, 4, 4);
        ctx.fillRect(enemy.x + 4, enemy.y - 12, 4, 4);
        ctx.shadowBlur = 0;
      } else if (enemy.type === 'nazgul') {
        // Zero-Day Exploit
        ctx.fillStyle = '#000040';
        ctx.shadowColor = '#0000ff';
        ctx.shadowBlur = 20;
        ctx.fillRect(enemy.x - 12, enemy.y - 12, 24, 24);
        ctx.shadowBlur = 0;
        
        // Stealth field
        ctx.fillStyle = '#000020';
        ctx.beginPath();
        ctx.arc(enemy.x, enemy.y, 15, 0, Math.PI * 2);
        ctx.fill();
        
        // Exploit vectors
        ctx.fillStyle = '#0080ff';
        ctx.shadowColor = '#0080ff';
        ctx.shadowBlur = 8;
        ctx.fillRect(enemy.x - 4, enemy.y - 8, 2, 3);
        ctx.fillRect(enemy.x + 2, enemy.y - 8, 2, 3);
        ctx.shadowBlur = 0;
        
        // Vulnerability scan
        ctx.strokeStyle = '#000040';
        ctx.lineWidth = 2;
        ctx.setLineDash([3, 3]);
        ctx.beginPath();
        ctx.arc(enemy.x, enemy.y, 20, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);
      }
      
      // Health bar
      const healthPercent = enemy.health / enemy.maxHealth;
      ctx.fillStyle = '#000000';
      ctx.fillRect(enemy.x - 15, enemy.y - 22, 30, 5);
      ctx.fillStyle = healthPercent > 0.5 ? '#00ff41' : healthPercent > 0.25 ? '#ffaa00' : '#ff0040';
      ctx.fillRect(enemy.x - 15, enemy.y - 22, 30 * healthPercent, 5);
      // Health bar border
      ctx.strokeStyle = '#00ff41';
      ctx.lineWidth = 1;
      ctx.strokeRect(enemy.x - 15, enemy.y - 22, 30, 5);
    });

    // Draw projectiles with LOTR styling
    projectiles.forEach(projectile => {
      // Reset effects
      ctx.shadowBlur = 0;
      ctx.shadowColor = 'transparent';
      
      if (projectile.type === 'arrow') {
        // Neo's Matrix Code Bullet
        ctx.strokeStyle = '#00ff41';
        ctx.lineWidth = 3;
        ctx.shadowColor = '#00ff41';
        ctx.shadowBlur = 5;
        
        // Bullet trail
        ctx.beginPath();
        ctx.moveTo(projectile.x - 6, projectile.y);
        ctx.lineTo(projectile.x + 6, projectile.y);
        ctx.stroke();
        ctx.shadowBlur = 0;
        
        // Code fragments
        ctx.fillStyle = '#00ff41';
        ctx.font = '8px monospace';
        ctx.fillText('1', projectile.x + 8, projectile.y - 2);
        ctx.fillText('0', projectile.x + 8, projectile.y + 6);
      } else if (projectile.type === 'fireball') {
        // Morpheus Wisdom Blast
        ctx.fillStyle = '#0080ff';
        ctx.shadowColor = '#0080ff';
        ctx.shadowBlur = 15;
        
        // Energy orb
        ctx.beginPath();
        ctx.arc(projectile.x, projectile.y, 5, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
        
        // Wisdom core
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(projectile.x, projectile.y, 3, 0, Math.PI * 2);
        ctx.fill();
        
        // Knowledge particles
        ctx.fillStyle = '#0080ff';
        ctx.font = '6px monospace';
        ctx.fillText('?', projectile.x - 10, projectile.y - 8);
        ctx.fillText('!', projectile.x + 8, projectile.y + 8);
      } else if (projectile.type === 'bolt') {
        // Trinity Sniper Shot
        ctx.strokeStyle = '#ffaa00';
        ctx.lineWidth = 4;
        ctx.shadowColor = '#ffaa00';
        ctx.shadowBlur = 8;
        
        // Sniper trail
        ctx.beginPath();
        ctx.moveTo(projectile.x - 8, projectile.y);
        ctx.lineTo(projectile.x + 8, projectile.y);
        ctx.stroke();
        ctx.shadowBlur = 0;
        
        // Precision targeting
        ctx.fillStyle = '#ffaa00';
        ctx.beginPath();
        ctx.arc(projectile.x + 6, projectile.y, 2, 0, Math.PI * 2);
        ctx.fill();
      } else if (projectile.type === 'virus') {
        // Sentinel Laser
        ctx.fillStyle = '#ff0040';
        ctx.shadowColor = '#ff0040';
        ctx.shadowBlur = 10;
        
        // Laser beam
        ctx.strokeStyle = '#ff0040';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(projectile.x - 10, projectile.y);
        ctx.lineTo(projectile.x + 10, projectile.y);
        ctx.stroke();
        ctx.shadowBlur = 0;
        
        // Laser core
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(projectile.x, projectile.y, 1, 0, Math.PI * 2);
        ctx.fill();
      }
    });

    // Draw UI
    ctx.fillStyle = '#00ff41';
    ctx.font = '14px monospace';
    ctx.shadowColor = '#00ff41';
    ctx.shadowBlur = 3;
    ctx.fillText(`CREDITS: ${gold}`, 130, 30);
    ctx.fillText(`SCORE: ${score}`, 130, 50);
    ctx.fillText(`NODES: ${lives}`, 130, 70);
    if (gameMode === 'campaign' && currentLevelData) {
      ctx.fillText(`WAVE: ${currentWaveIndex + 1}/${currentLevelData.waves.length}`, 130, 90);
      ctx.fillText(`LEVEL: ${currentLevel}`, 130, 110);
    } else {
      ctx.fillText(`WAVE: ${wave}`, 130, 90);
    }
    ctx.shadowBlur = 0;
  }, [towers, enemies, projectiles, selectedTowerType, gold, score, lives, wave, gameMode, currentLevelData, currentWaveIndex, currentLevel]);

  // Reset wave tracking when level changes
  useEffect(() => {
    setCurrentWaveIndex(0);
    setWaveEnemiesSpawned(0);
    setWaveTimer(0);
    setWave(1);
    setLastSpawnTime(0);
    setTriggeredQuizzes(new Set()); // Reset triggered quizzes for new level
  }, [currentLevel]);

  useEffect(() => {
    const gameLoop = () => {
      updateGame();
      draw();
      gameLoopRef.current = requestAnimationFrame(gameLoop);
    };

    if (gameState === 'playing') {
      gameLoopRef.current = requestAnimationFrame(gameLoop);
    }

    return () => {
      if (gameLoopRef.current) {
        cancelAnimationFrame(gameLoopRef.current);
      }
    };
  }, [updateGame, draw, gameState]);

  useEffect(() => {
    if (lives <= 0) {
      onGameStateChange('gameOver');
    }
  }, [lives, onGameStateChange]);
  
  return (
    <div className="flex flex-col lg:flex-row min-h-screen bg-slate-900">
      {/* Game Canvas */}
      <div className="flex-1 flex items-center justify-center p-4">
        <div className="relative">
          <canvas
            ref={canvasRef}
            width={800}
            height={600}
            className="border-2 border-amber-500/30 rounded-lg bg-slate-800 cursor-crosshair"
            onClick={handleCanvasClick}
          />
          
          {gameState === 'paused' && (
            <div className="absolute inset-0 bg-black/70 flex items-center justify-center rounded-lg">
              <div className="text-white text-3xl font-bold">PAUSED</div>
            </div>
          )}
        </div>
      </div>

      {/* Level Progress Tracker */}
      {gameMode === 'campaign' && currentLevelData && (
        <div className="absolute top-4 right-96 w-80">
          <LevelProgressTracker
            currentLevel={currentLevel}
            correctAnswers={correctAnswersInLevel}
            requiredAnswers={5}
            levelName={currentLevelData.name}
          />
        </div>
      )}

      {/* Tower Selection Panel */}
      <div className="w-full lg:w-80 bg-slate-800 border-l border-slate-700 p-6">
        <h3 className="text-xl font-bold text-amber-400 mb-4">Defense Arsenal</h3>
        
        <div className="space-y-3 mb-6">
          {Object.entries(towerTypes).map(([type, config]) => (
            <button
              key={type}
              onClick={() => setSelectedTowerType(type as Tower['type'])}
              className={`w-full p-3 rounded-lg border-2 transition-all ${
                selectedTowerType === type
                  ? 'border-amber-500 bg-amber-500/20'
                  : 'border-slate-600 hover:border-slate-500'
              }`}
              disabled={gold < config.cost}
            >
              <div className="flex items-center justify-between">
                <div className="text-left">
                  <div className="font-semibold text-white">{config.name}</div>
                  <div className="text-xs text-slate-400">
                    {config.description}
                  </div>
                  <div className="text-xs text-slate-400">
                    Damage: {config.damage} | Range: {config.range}
                  </div>
                </div>
                <div className="text-amber-400 font-bold">{config.cost}g</div>
              </div>
            </button>
          ))}
        </div>

        <div className="bg-slate-700/50 rounded-lg p-4">
          <h4 className="font-semibold text-amber-400 mb-2">Game Stats</h4>
          <div className="space-y-1 text-sm">
            <div className="flex justify-between">
              <span className="text-slate-300">Enemies Defeated:</span>
              <span className="text-white">{Math.floor(score / 100)}</span>
            </div>
            <div className="flex justify-between">
              <span className="text-slate-300">Defense Nodes:</span>
              <span className="text-white">{towers.length}</span>
            </div>
            <div className="flex justify-between">
              <span className="text-slate-300">Current Wave:</span>
              <span className="text-white">{wave}</span>
            </div>
          </div>
        </div>

        <div className="mt-4 text-xs text-slate-400">
          <p>Click on the digital grid to deploy defense nodes</p>
          <p>Answer security protocols for bonus credits!</p>
        </div>
      </div>

      {/* Security Quiz Modal */}
      {showQuiz && currentQuiz && (
        <SecurityQuizModal
          question={currentQuiz}
          onAnswer={handleQuizAnswer}
          onClose={() => {
            setShowQuiz(false);
            setCurrentQuiz(null);
            onGameStateChange('playing');
          }}
        />
      )}

      {/* Security Tip Modal */}
      {showSecurityTip && currentSecurityTip && (
        <SecurityTipModal
          tip={currentSecurityTip}
          onClose={handleSecurityTipClose}
        />
      )}
    </div>
  );
};

export default TowerDefenseGame;
