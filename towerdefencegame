  const updateGame = useCallback(() => {
    if (gameState !== 'playing') return;

    const currentTime = Date.now();

    // Update enemies
    setEnemies(prev => {
      const updatedEnemies = prev.map(enemy => {
        if (enemy.pathIndex < enemy.path.length - 1) {
          const currentTarget = enemy.path[enemy.pathIndex + 1];
          const dx = currentTarget.x - enemy.x;
          const dy = currentTarget.y - enemy.y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          
          if (distance < 5) {
            enemy.pathIndex++;
          } else {
            enemy.x += (dx / distance) * enemy.speed;
            enemy.y += (dy / distance) * enemy.speed;
          }
        }
        return enemy;
      });

      // Remove enemies that reached the end
      const remainingEnemies = updatedEnemies.filter(enemy => {
        if (enemy.pathIndex >= enemy.path.length - 1 && 
            Math.abs(enemy.x - enemy.path[enemy.path.length - 1].x) < 10) {
          setLives(prev => {
            const newLives = prev - 1;
            onLivesUpdate(newLives);
            return newLives;
          });
          return false;
        }
        return true;
      });

      return remainingEnemies;
    });

    // Tower shooting logic
    setTowers(prev => {
      return prev.map(tower => {
        if (currentTime - tower.lastFired > tower.fireRate) {
          // Find nearest enemy in range
          const nearestEnemy = enemies.find(enemy => {
            const dx = enemy.x - tower.x;
            const dy = enemy.y - tower.y;
            const distance = Math.sqrt(dx * dx + dy * dy);
            return distance <= tower.range;
          });

          if (nearestEnemy) {
            // Create projectile
            const projectile: Projectile = {
              id: Math.random().toString(36).substr(2, 9),
              x: tower.x,
              y: tower.y,
              targetX: nearestEnemy.x,
              targetY: nearestEnemy.y,
              speed: 5,
              damage: tower.damage,
              type: tower.type === 'mage' ? 'fireball' : 'arrow'
            };

            setProjectiles(prev => [...prev, projectile]);
            tower.lastFired = currentTime;
          }
        }
        return tower;
      });
    });

    // Update projectiles
    setProjectiles(prev => {
      return prev.filter(projectile => {
        const dx = projectile.targetX - projectile.x;
        const dy = projectile.targetY - projectile.y;
        const distance = Math.sqrt(dx * dx + dy * dy);
        
        if (distance < 10) {
          // Hit target - damage enemy
          setEnemies(prevEnemies => {
            return prevEnemies.map(enemy => {
              const enemyDx = enemy.x - projectile.targetX;
              const enemyDy = enemy.y - projectile.targetY;
              const enemyDistance = Math.sqrt(enemyDx * enemyDx + enemyDy * enemyDy);
              
              if (enemyDistance < 30) {
                enemy.health -= projectile.damage;
                if (enemy.health <= 0) {
                  setScore(prevScore => {
                    const newScore = prevScore + enemy.points;
                    onScoreUpdate(newScore);
                    return newScore;
                  });
                  setGold(prevGold => prevGold + enemy.points / 4);
                  
                  // Random chance for quiz
                  if (Math.random() < 0.03) { // Further reduced quiz frequency to prevent spam
                    setTimeout(() => triggerQuiz(), 500);
                  }
                }
              }
              return enemy;
            }).filter(enemy => enemy.health > 0);
          });
          return false;
        }
        
        projectile.x += (dx / distance) * projectile.speed;
        projectile.y += (dy / distance) * projectile.speed;
        return true;
      });
    });

    // Spawn enemies periodically
